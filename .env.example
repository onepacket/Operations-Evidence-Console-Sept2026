# PostgreSQL connection string. Required by the API, schema tools, seed, and reset.
DATABASE_URL=

# Port exposed by the currently running API or Vite process.
PORT=

# Artifact route prefix used by Vite in Replit's path-based preview.
BASE_PATH=

# Runtime mode used for logging, proxy behavior, and production builds.
NODE_ENV=

# Clerk browser key used by the frontend.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional frontend Clerk proxy URL for a published deployment.
VITE_CLERK_PROXY_URL=

# Clerk publishable key used by the API middleware.
CLERK_PUBLISHABLE_KEY=

# Clerk server key used by the API proxy and seed command.
CLERK_SECRET_KEY=

# Password used only when the seed command must create a missing demo user.
DEMO_USER_PASSWORD=

# Session signing secret; also the fallback credential for the internal job endpoint.
SESSION_SECRET=

# Preferred credential for POST /api/jobs/process-imports.
OPERATIONS_JOB_TOKEN=

# Shared HMAC secret for POST /api/webhooks/inbound.
INBOUND_WEBHOOK_SECRET=

# Optional scheduler interval in milliseconds; values below 10000 use the default.
OPERATIONS_SCHEDULER_INTERVAL_MS=

# Optional API base URL used by the inbound-event demonstration script.
OPERATIONS_API_URL=

# Replit-managed OpenAI proxy credential.
AI_INTEGRATIONS_OPENAI_API_KEY=

# Replit-managed OpenAI proxy base URL.
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Replit Object Storage bucket identifier.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# Private object-entity directory used for protected uploads.
PRIVATE_OBJECT_DIR=

# Colon-separated Object Storage paths that may be served publicly.
PUBLIC_OBJECT_SEARCH_PATHS=

# Optional API log level, such as info, warn, or error.
LOG_LEVEL=

# Replit workspace identifier, supplied automatically on Replit.
REPL_ID=
